# --- Secrets -----------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Terraform ---------------------------------------------------------------
# State holds every secret this config touched. Never commit it.
**/.terraform/*
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
*.tfvars
*.tfvars.json
!*.tfvars.example
tfplan
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# Do commit the lock file: it is what makes a plan reproducible.
!.terraform.lock.hcl
# backend.tf is per-team; backend.tf.example is the documented template.
terraform/backend.tf

# --- Local scratch -----------------------------------------------------------
.kubeconfig
.root-app.rendered.yaml
graph.svg
*.tgz

# --- OS / editors ------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
*~
