# Copy to .env and fill in. .env is git-ignored.

# --- Required ----------------------------------------------------------------
# A Confluent Cloud *Cloud resource management* API key, owned by a user or
# service account with OrganizationAdmin. Needed to create the environment,
# and the PrivateLink gateway.
#   confluent.cloud -> top right menu -> API keys -> Add key -> Cloud resource
# management
CONFLUENT_CLOUD_API_KEY=
CONFLUENT_CLOUD_API_SECRET=

# --- AWS (optional) -----------------------------------------------------------
# Which SSO profile to use, if you do not want to set it in your shell.
# Check the account can actually host this before you apply: make preflight
# AWS_PROFILE=my-account/nonprod-administrator

# --- Overrides (optional) -----------------------------------------------------
# These become TF_VAR_name / TF_VAR_region, overriding the defaults in
# terraform/variables.tf without editing a single .tf file.
#
# Anything already set in your shell beats what is in this file, so a one-off
# is just:  DEMO_REGION=eu-west-1 make plan
# DEMO_NAME=tf-brownbag
# DEMO_REGION=us-east-1
