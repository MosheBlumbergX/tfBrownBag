{
  "type": "record",
  "name": "Order",
  "namespace": "io.example.orders",
  "fields": [
    { "name": "order_id", "type": "string" },
    { "name": "customer_id", "type": "string" },
    { "name": "amount", "type": "double" },
    { "name": "currency", "type": "string", "default": "GBP" },
    { "name": "channel", "type": "string", "default": "web" },
    { "name": "region", "type": "string" }
  ]
}
